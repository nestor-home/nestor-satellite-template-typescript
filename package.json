{
  "name": "my-satellite",
  "version": "0.2.1",
  "description": "A Nestor satellite.",
  "license": "MIT",
  "author": "Your Name",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.23.0",
  "bin": {
    "my-satellite": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "conformance": "pnpm build && vitest run --config vitest.conformance.config.ts"
  },
  "dependencies": {
    "@nestor-home/satellite": "0.7.0",
    "@roamhq/wrtc": "0.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
