{
  "name": "my-satellite",
  "version": "0.1.1",
  "description": "A Nestor satellite.",
  "license": "MIT",
  "author": "Your Name",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "my-satellite": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "conformance": "pnpm build && vitest run --config vitest.conformance.config.ts"
  },
  "dependencies": {
    "@nestor-home/satellite": "0.5.0",
    "@roamhq/wrtc": "0.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
